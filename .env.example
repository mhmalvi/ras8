# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit actual secrets to version control

# Shopify Configuration
VITE_SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# Application URLs
VITE_APP_URL=your_app_url_here
VITE_DEV_MODE=false

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# Sentry Error Tracking (Optional but Recommended)
# Get your DSN from https://sentry.io project settings
SENTRY_DSN=https://05397d5092e8450f10fbca3065050981@o4510600929804288.ingest.us.sentry.io/4510600959361024
VITE_SENTRY_DSN=https://a1c62da2259a812ebc1f3d484948b50e@o4510600929804288.ingest.us.sentry.io/4510600970502144
# Enable Sentry in development (optional, default: false)
# VITE_SENTRY_ENABLED=true

# Build Configuration
NODE_ENV=production

# Additional API Keys (add as needed)
# OPENAI_API_KEY=your_openai_api_key_here
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
